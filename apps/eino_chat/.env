# # ark model: https://console.volcengine.com/ark
# # 以下ARK配置已注释，当前使用智谱AI
# # 火山云方舟 ChatModel 的 Endpoint ID
# export ARK_CHAT_MODEL="doubao-pro-32k-xxxxxx" 
# # 火山云方舟 向量化模型的 Endpoint ID
# export ARK_EMBEDDING_MODEL="doubao-embedding-large-text-xxxxxx" 
# # 火山云方舟的 API Key
# export ARK_API_KEY=""  
# export ARK_API_BASE_URL="https://ark.cn-xxxxxx.volces.com/api/v3" 

# # apmplus: https://console.volcengine.com/apmplus-server
# # 下面必填环境变量如果为空，则不开启 apmplus callback
# # APMPlus 的 App Key，必填
# export APMPLUS_APP_KEY=""
# # APMPlus 的 Region，选填，不填写时，默认是 cn-beijing
# export APMPLUS_REGION=""

# # langfuse: https://cloud.langfuse.com/
# # 下面两个环境变量如果为空，则不开启 langfuse callback
# # Langfuse Project 的 Public Key
# export LANGFUSE_PUBLIC_KEY=""
# # Langfuse Project 的 Secret Key。 注意，Secret Key 仅可在被创建时查看一次
# export LANGFUSE_SECRET_KEY=""

# # Redis Server 的地址，不填写时，默认是 localhost:6379
# export REDIS_ADDR=172.18.73.146:16379


# # 或者也可以选择其他ai平台
# # 智谱AI平台API配置 - 已启用
# # 智谱AI API密钥，必填
export ZHIPUAI_API_KEY=""   # 已配置的智谱AI API密钥
# # 智谱AI API基础URL，选填，不填写时使用默认值
# export ZHIPUAI_API_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
# # 智谱AI模型ID，选填，可根据需要设置默认模型
# export ZHIPUAI_DEFAULT_MODEL="glm-4.5"


# 服务端口
PORT=8000

# 知识库配置
KNOWLEDGE_BASE=cmd/knowledge_base/eino-docs

# Redis配置
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=

# 模型配置
MODEL_ENDPOINT="https://open.bigmodel.cn/api/paas/v4"
MODEL_API_KEY=""

# 日志级别
LOG_LEVEL=info

# 嵌入模型配置
EMBEDDING_MODEL="embedding-2"

